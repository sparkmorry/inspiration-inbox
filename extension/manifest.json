{
  "manifest_version": 3,
  "name": "灵感库",
  "version": "1.2.0",
  "description": "右键把网页图片保存到本机灵感库",
  "permissions": ["contextMenus", "notifications"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:3921/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "灵感库",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pick-url.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
